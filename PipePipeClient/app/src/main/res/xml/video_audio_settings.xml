<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_player_title">

    <ListPreference
        android:defaultValue="@string/default_resolution_value"
        android:entries="@array/resolution_list_description"
        android:entryValues="@array/resolution_list_values"
        android:key="@string/default_resolution_key"
        android:summary="%s"
        android:title="@string/default_resolution_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="@string/default_popup_resolution_value"
        android:entries="@array/resolution_list_description"
        android:entryValues="@array/resolution_list_values"
        android:key="@string/default_popup_resolution_key"
        android:summary="%s"
        android:title="@string/default_popup_resolution_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:key="@string/preferred_audio_quality_key"
        android:defaultValue="high"
        android:entries="@array/audio_quality_names"
        android:entryValues="@array/audio_quality_values"
        android:title="@string/preferred_audio_quality_title"
        android:summary="%s"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <MultiSelectListPreference
            android:key="@string/advanced_formats_key"
            android:title="@string/advanced_formats_title"
            android:summary="@string/advanced_formats_summary"
            android:entries="@array/advanced_formats_values"
            android:entryValues="@array/advanced_formats_values"
            android:defaultValue="@array/default_advanced_formats_values"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/pin_video_to_top_key"
            android:title="@string/pin_video_to_top_title"
            android:summary="@string/pin_video_to_top_summary"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"/>

    <ListPreference
            android:defaultValue="@string/preferred_open_action_default"
            android:entries="@array/preferred_open_action_description_list"
            android:entryValues="@array/preferred_open_action_values_list"
            android:key="@string/preferred_open_action_key"
            android:summary="@string/preferred_open_action_settings_summary"
            android:title="@string/preferred_open_action_settings_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <ListPreference
            android:defaultValue="@string/minimize_on_exit_value"
            android:entries="@array/minimize_on_exit_action_description"
            android:entryValues="@array/minimize_on_exit_action_key"
            android:key="@string/minimize_on_exit_key"
            android:summary="@string/minimize_on_exit_summary"
            android:title="@string/minimize_on_exit_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <ListPreference
            android:defaultValue="@string/autoplay_value"
            android:entries="@array/autoplay_type_description"
            android:entryValues="@array/autoplay_type_key"
            android:key="@string/autoplay_key"
            android:summary="@string/autoplay_summary"
            android:title="@string/autoplay_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/auto_queue_key"
            android:summary="@string/auto_queue_summary"
            android:title="@string/auto_queue_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/dont_auto_queue_long_key"
            android:summary="@string/dont_auto_queue_long_description"
            android:title="@string/dont_auto_queue_long_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/auto_background_play_key"
            android:title="@string/auto_background_play_title"
            android:summary="@string/auto_background_play_summary"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"/>

    <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="@string/auto_background_play_key"
            android:key="@string/random_music_play_mode_key"
            android:title="@string/random_play_order_title"
            android:summary="@string/random_play_order_summary"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"/>

    <ListPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:defaultValue="15"
            android:entries="@array/sleep_timer_length_key"
            android:entryValues="@array/sleep_timer_length_value"
            android:key="@string/sleep_timer_length_key"
            android:summary="%s"
            android:title="@string/sleep_timer_length_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="@string/caption_settings_key"
            android:summary="@string/caption_setting_description"
            android:title="@string/caption_setting_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/rotate_fullscreen_to_video_orientation_key"
            android:summary="@string/rotate_fullscreen_to_video_orientation_summary"
            android:title="@string/rotate_fullscreen_to_video_orientation_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:key="@string/rotation_controls_fullscreen_key"
            android:summary="@string/rotation_controls_fullscreen_summary"
            android:title="@string/rotation_controls_fullscreen_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/seek_on_media_button_events_key"
            android:title="@string/seek_on_media_button_events_title"
            android:summary="@string/seek_on_media_button_events_summary"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/leveler_category_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false">

        <Preference
            android:key="@string/leveler_status_key"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/leveler_status_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/leveler_enabled_key"
            android:summary="@string/leveler_enabled_summary"
            android:title="@string/leveler_enabled_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="@string/leveler_noise_default"
            android:dependency="@string/leveler_enabled_key"
            android:entries="@array/leveler_noise_descriptions"
            android:entryValues="@array/leveler_noise_values"
            android:key="@string/leveler_noise_key"
            android:title="@string/leveler_noise_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="@string/leveler_keep_speech_default"
            android:dependency="@string/leveler_enabled_key"
            android:entries="@array/leveler_keep_speech_descriptions"
            android:entryValues="@array/leveler_keep_speech_values"
            android:key="@string/leveler_keep_speech_key"
            android:title="@string/leveler_keep_speech_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="@string/leveler_enabled_key"
            android:key="@string/leveler_clarity_key"
            android:summary="@string/leveler_clarity_summary"
            android:title="@string/leveler_clarity_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="@string/leveler_strength_default"
            android:dependency="@string/leveler_enabled_key"
            android:entries="@array/leveler_strength_descriptions"
            android:entryValues="@array/leveler_strength_values"
            android:key="@string/leveler_strength_key"
            android:title="@string/leveler_strength_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="@string/leveler_target_default"
            android:dependency="@string/leveler_enabled_key"
            android:entries="@array/leveler_target_descriptions"
            android:entryValues="@array/leveler_target_values"
            android:key="@string/leveler_target_key"
            android:title="@string/leveler_target_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="@string/leveler_max_boost_default"
            android:dependency="@string/leveler_enabled_key"
            android:entries="@array/leveler_max_boost_descriptions"
            android:entryValues="@array/leveler_max_boost_values"
            android:key="@string/leveler_max_boost_key"
            android:title="@string/leveler_max_boost_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="@string/leveler_ratio_default"
            android:dependency="@string/leveler_enabled_key"
            android:entries="@array/leveler_ratio_descriptions"
            android:entryValues="@array/leveler_ratio_values"
            android:key="@string/leveler_ratio_key"
            android:title="@string/leveler_ratio_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
</PreferenceScreen>
